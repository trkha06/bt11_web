<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><title>Đăng ký</title></head><body><div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3">Đăng ký tài khoản</h1><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/register"><div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required maxlength="50"></div><div class="mb-3"><label class="form-label">Họ tên</label><input name="fullname" class="form-control" required maxlength="50"></div><div class="mb-3"><label class="form-label">Phone</label><input name="phone" class="form-control" required pattern="[0-9]{9,10}"></div><div class="mb-3"><label class="form-label">Mật khẩu</label><input name="password" type="password" class="form-control" required minlength="6"></div><div class="mb-3"><label class="form-label">Xác nhận mật khẩu</label><input name="confirmPassword" type="password" class="form-control" required minlength="6"></div><button class="btn btn-primary w-100">Đăng ký và nhận OTP</button></form></div></div></div></div></body></html>
