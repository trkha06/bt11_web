<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><title>Xác thực OTP</title></head><body><div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3">Kích hoạt bằng OTP</h1><c:if test="${not empty notice}"><div class="alert alert-info">${notice}</div></c:if><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/verify-otp"><label class="form-label">Mã OTP 6 chữ số</label><input name="otp" class="form-control mb-3" required pattern="[0-9]{6}" maxlength="6"><button class="btn btn-primary w-100">Xác thực</button></form></div></div></div></div></body></html>
