<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><title>Đăng nhập</title></head><body><div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3">Đăng nhập</h1><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/login"><div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required></div><div class="mb-3"><label class="form-label">Mật khẩu</label><input name="password" type="password" class="form-control" required></div><button class="btn btn-primary w-100">Đăng nhập</button></form><p class="mt-3 mb-0">Chưa có tài khoản? <a href="${pageContext.request.contextPath}/register">Đăng ký</a></p></div></div></div></div></body></html>
