<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><title>${book.bookId == 0 ? 'Thêm sách' : 'Sửa sách'}</title></head><body><div class="row justify-content-center"><div class="col-lg-8"><div class="d-flex justify-content-between align-items-center"><h1 class="h3">${book.bookId == 0 ? 'Thêm Book' : 'Cập nhật Book'}</h1><a href="${pageContext.request.contextPath}/admin/books">← Danh sách</a></div><div class="card shadow-sm"><div class="card-body"><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/admin/books/${book.bookId == 0 ? 'add' : 'edit'}"><input type="hidden" name="bookId" value="${book.bookId}"><div class="row"><div class="col-md-6 mb-3"><label class="form-label">ISBN</label><input name="isbn" type="number" min="1" class="form-control" value="${book.isbn}" required></div><div class="col-md-6 mb-3"><label class="form-label">Quantity</label><input name="quantity" type="number" min="0" class="form-control" value="${book.quantity}" required></div></div><div class="mb-3"><label class="form-label">Title</label><input name="title" class="form-control" value="<c:out value='${book.title}'/>" required maxlength="200"></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Publisher</label><input name="publisher" class="form-control" value="<c:out value='${book.publisher}'/>" required maxlength="100"></div><div class="col-md-3 mb-3"><label class="form-label">Price</label><input name="price" type="number" min="0" step="0.01" class="form-control" value="${book.price}" required></div><div class="col-md-3 mb-3"><label class="form-label">Publish Date</label><input name="publishDate" type="date" class="form-control" value="${book.publishDate}" required></div></div><div class="mb-3"><label class="form-label">Cover Image URL</label><input name="coverImage" type="url" class="form-control" value="<c:out value='${book.coverImage}'/>" required maxlength="100"></div><div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="4"><c:out value="${book.description}"/></textarea></div><button class="btn btn-primary">Lưu</button></form></div></div></div></div></body></html>
