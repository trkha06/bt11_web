<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><title>Quản lý sách</title></head><body><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Quản lý Books</h1><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/books/add">Add Book</a></div><div class="table-responsive"><table class="table table-striped align-middle bg-white"><thead><tr><th>ID</th><th>Cover Image</th><th>ISBN</th><th>Title</th><th>Publisher</th><th>Price</th><th>Publish Date</th><th>Quantity</th><th>Actions</th></tr></thead><tbody><c:forEach items="${books}" var="book"><tr><td>${book.bookId}</td><td><img src="${book.coverImage}" style="width:45px;height:60px;object-fit:cover" alt="cover"></td><td>${book.isbn}</td><td><c:out value="${book.title}"/></td><td><c:out value="${book.publisher}"/></td><td>${book.price}</td><td>${book.publishDate}</td><td>${book.quantity}</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/books/edit?id=${book.bookId}">Edit</a><form class="d-inline" method="post" action="${pageContext.request.contextPath}/admin/books/delete" onsubmit="return confirm('Xóa sách này? Các review và tác giả liên kết cũng sẽ được xóa.');"><input type="hidden" name="id" value="${book.bookId}"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr></c:forEach></tbody></table></div><nav><ul class="pagination justify-content-center"><li class="page-item ${page==1?'disabled':''}"><a class="page-link" href="${pageContext.request.contextPath}/admin/books?page=${page-1}">Trang trước</a></li><c:forEach begin="1" end="${totalPages}" var="i"><li class="page-item ${page==i?'active':''}"><a class="page-link" href="${pageContext.request.contextPath}/admin/books?page=${i}">${i}</a></li></c:forEach><li class="page-item ${page==totalPages?'disabled':''}"><a class="page-link" href="${pageContext.request.contextPath}/admin/books?page=${page+1}">Trang sau</a></li></ul></nav></body></html>
